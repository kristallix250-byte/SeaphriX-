NODE_ENV=development
PORT=3000
# Mindestens 32 Zeichen, zufällig (openssl rand -hex 32)
JWT_SECRET=
ENCRYPTION_KEY=
DATABASE_URL=postgres://saephrix:CHANGE_ME@localhost:5432/saephrix
CORS_ORIGINS=http://localhost:8080
RATE_LIMIT_PER_MIN=60
MAX_PROMPT_CHARS=8000
REQUEST_TIMEOUT_MS=60000
LOG_LEVEL=info

# Reihenfolge = Fallback-Kette (nur konfigurierte Provider werden genutzt)
AI_PROVIDER_ORDER=ollama,openai,anthropic,gemini,meta
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Meta AI / Llama über OpenAI-kompatiblen Endpunkt (z. B. Llama API, Together, vLLM)
META_API_KEY=
META_BASE_URL=
META_MODEL=llama-3.1-8b-instruct
# Lokal / offline
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
